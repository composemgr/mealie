# Mealie Recipe Manager - Environment Variables
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Host settings
BASE_HOST_NAME=mealie.example.com

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=mealie
DB_USER_NAME=mealie
DB_USER_PASS=changeme_db_password

# Application
APP_ORG_NAME=Mealie
ALLOW_SIGNUP=true

# Email (SMTP)
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
EMAIL_SERVER_MAIL_FROM=no-reply@example.com
